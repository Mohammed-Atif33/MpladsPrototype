# ---------------------------------------------------------------
# MPLADS Risk Intelligence Platform - environment template
# `python setup.py` creates .env from this file for you (it asks for your PostgreSQL
# connection and generates a random JWT secret). NEVER share the real .env.
# ---------------------------------------------------------------
APP_ENV=development

# --- PostgreSQL connection (used by the backend) ---
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE   (special characters in the password must be URL-encoded)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mplads
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Demo behaviour (synthetic data only) ---
SEED_ON_STARTUP=true
DEMO_PASSWORD=Demo@12345
SHOW_DEMO_CREDENTIALS=true
ENABLE_SCHEDULER=true
# Citizen self-registration (always creates a Citizen). Admin-created accounts work either way.
ALLOW_SIGNUP=true
